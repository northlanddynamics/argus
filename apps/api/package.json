{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./cases/vocabulary": "./src/cases/vocabulary.ts",
    "./cases/case-summary": "./src/cases/case-summary.ts",
    "./realtime/messages": "./src/realtime/messages.ts",
    "./timeline/occurred-at": "./src/timeline/occurred-at.ts",
    "./observables/vocabulary": "./src/observables/vocabulary.ts",
    "./case-links/vocabulary": "./src/case-links/vocabulary.ts",
    "./tags/vocabulary": "./src/tags/vocabulary.ts",
    "./alerts/vocabulary": "./src/alerts/vocabulary.ts",
    "./integrations/vocabulary": "./src/integrations/vocabulary.ts",
    "./internal/vocabulary": "./src/internal/vocabulary.ts",
    "./case-reports/vocabulary": "./src/case-reports/vocabulary.ts",
    "./search/vocabulary": "./src/search/vocabulary.ts",
    "./metrics/vocabulary": "./src/metrics/vocabulary.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e",
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate-cli.ts",
    "operator:create": "bun src/scripts/create-operator.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@pdf-lib/fontkit": "1.1.1",
    "better-auth": "^1.7.14",
    "dejavu-fonts-ttf": "2.37.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "auth": "1.7.14",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.63.0",
    "samlify": "2.15.1",
    "typescript": "^7.0.2"
  }
}
