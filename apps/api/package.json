{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e",
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate-cli.ts",
    "operator:create": "bun src/scripts/create-operator.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "auth": "1.7.14",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
