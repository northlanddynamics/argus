{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/api/drizzle/**",
    "apps/web/src/components/ui/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/api/src/routes/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "Routes go through a module (src/modules.ts); only modules touch the database (ADR 0006)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/db/*",
                  "drizzle-orm/*"
                ],
                "message": "Routes go through a module (src/modules.ts); only modules touch the database (ADR 0006)."
              }
            ]
          }
        ]
      }
    }
  ]
}
