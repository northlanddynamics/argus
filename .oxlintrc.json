{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn"
  ],
  "jsPlugins": [
    "@shadcn/lint"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/api/drizzle/**",
    "apps/web/src/components/ui/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout",
          "gap-*",
          "gap-x-*",
          "gap-y-*"
        ],
        "contracts": [
          {
            "pattern": "^(Sidebar|Card|Field|FieldGroup|Collapsible|RadioGroup|Command)$|(Content|Header|Footer|Panel|List|Action)$",
            "allow": [
              "layout",
              "spacing",
              "border-t",
              "border-b",
              "border-r",
              "border-b-0",
              "divide-y"
            ]
          },
          {
            "pattern": "^Skeleton$",
            "allow": [
              "layout",
              "shape"
            ]
          },
          {
            "pattern": "^Badge$",
            "allow": [
              "layout",
              "typography"
            ]
          },
          {
            "pattern": "^(Input|Textarea)$",
            "allow": [
              "layout",
              "font-mono",
              "text-xs",
              "bg-background"
            ]
          },
          {
            "pattern": "^Table(Head|Cell)$",
            "allow": [
              "layout",
              "spacing",
              "typography",
              "text-muted-foreground",
              "text-foreground"
            ]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout"
        ]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/api/src/routes/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "Routes go through a module (src/modules.ts); only modules touch the database (ADR 0006)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/db/*",
                  "drizzle-orm/*"
                ],
                "message": "Routes go through a module (src/modules.ts); only modules touch the database (ADR 0006)."
              }
            ]
          }
        ]
      }
    }
  ]
}
