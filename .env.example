DATABASE_URL=postgres://postgres:postgres@localhost:5432/argus
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000
# Optional; without it, mail is logged to the console.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Argus <no-reply@example.com>
# Evidence storage: an S3-compatible bucket. Without S3_BUCKET, Evidence uploads and downloads fail.
# S3_BUCKET=argus-evidence
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# EVIDENCE_MAX_BYTES=68719476736
# Tests: an admin connection used to create a database per test.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Seals Integration credentials (Falcon API client secrets) at rest. Defaults to BETTER_AUTH_SECRET.
# CREDENTIALS_SECRET=another-long-random-string
